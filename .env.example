# Tuffs environment configuration (example - no real secrets).
# Copy to .env (or export in your process manager) and adjust.

# Port the portal listens on.
PORT=8080

# ---- Authentication (optional but recommended for public deployments) ----
# When set, every page (and the proxy backend) requires this token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TUFFS_ACCESS_TOKEN=

# Secret used to sign session cookies. If omitted while TUFFS_ACCESS_TOKEN is
# set, a random secret is generated per process (sessions reset on restart).
TUFFS_SESSION_SECRET=

# ---- Proxy destination policy (enforced by the Wisp backend) ----
# Comma-separated hostnames or regexes. When an allowlist is set it fully
# replaces the default blocklist - ONLY these destinations are reachable.
# Example: TUFFS_PROXY_ALLOWLIST=wikipedia.org,en.wikipedia.org,*.wikipedia.org
TUFFS_PROXY_ALLOWLIST=

# Extra blocklist entries (used only when no allowlist is set). The default
# blocklist already covers localhost, *.local, *.internal, *.lan, *.home and
# cloud metadata endpoints; private/loopback IPs are always blocked.
TUFFS_PROXY_BLOCKLIST=

# ---- Proxy resource limits ----
# Max simultaneous streams per wisp connection (-1 = unlimited).
TUFFS_STREAM_LIMIT_TOTAL=-1
TUFFS_STREAM_LIMIT_PER_HOST=-1

# Allow UDP streams through the proxy (default false - most browsing does not
# need it and it widens the attack surface).
TUFFS_ALLOW_UDP=false

# DNS resolvers used by the proxy backend (default: Cloudflare security).
TUFFS_DNS_SERVERS=1.1.1.3,1.0.0.3

# ---- Catalog policy ----
# When "true", games whose license could not be verified are hidden from the
# catalog (only the MIT-licensed 2048 remains). Default false shows all games
# with their license status visible in the UI.
TUFFS_STRICT_LICENSE_MODE=false
